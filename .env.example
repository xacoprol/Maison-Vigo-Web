# URL pública del API Care (Railway), sin barra final.
# Ejemplo: https://tu-api.up.railway.app
NEXT_PUBLIC_CARE_API_BASE_URL=

# Opcional en servidor (mismas llamadas RSC). Si falta, se usa NEXT_PUBLIC_*.
# CARE_API_BASE_URL=

# Sitio
# NEXT_PUBLIC_SITE_URL=https://maisonvigo.es

# Google Places API (New) — reseñas en home. Solo servidor (sin NEXT_PUBLIC_).
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
# Si la key está restringida por HTTP referrer (habitual en keys web):
# GOOGLE_PLACES_HTTP_REFERER=https://maisonvigo.es/
